# Managed by Ansible
name: {{ inventory_hostname }}
data-dir: {{ etcd_data_dir }}
listen-peer-urls: {{ tls_scheme }}://{{ database_ip }}:{{ etcd_peer_port }}
listen-client-urls: {{ tls_scheme }}://{{ database_ip }}:{{ etcd_client_port }},{{ tls_scheme }}://127.0.0.1:{{ etcd_client_port }}
initial-advertise-peer-urls: {{ tls_scheme }}://{{ database_ip }}:{{ etcd_peer_port }}
advertise-client-urls: {{ tls_scheme }}://{{ database_ip }}:{{ etcd_client_port }}
initial-cluster-token: {{ etcd_token }}
initial-cluster-state: new
initial-cluster: {% for h in groups['database'] %}{{ h }}={{ tls_scheme }}://{{ hostvars[h].ansible_host | default(h) }}:{{ etcd_peer_port }}{{ ',' if not loop.last else '' }}{% endfor %}

{% if tls_active | bool %}
client-transport-security:
  cert-file: /etc/etcd/tls/server.crt
  key-file: /etc/etcd/tls/server.key
  trusted-ca-file: /etc/etcd/tls/ca.crt
peer-transport-security:
  cert-file: /etc/etcd/tls/server.crt
  key-file: /etc/etcd/tls/server.key
  trusted-ca-file: /etc/etcd/tls/ca.crt
{% endif %}
